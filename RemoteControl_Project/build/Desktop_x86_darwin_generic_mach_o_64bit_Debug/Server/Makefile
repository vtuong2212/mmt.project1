	cd /Users/huathaiviettuong/Downloads/bun123/mmt.project1/RemoteControl_Project/build/Desktop_x86_darwin_generic_mach_o_64bit_Debug && $(MAKE) $(MAKESILENT) -f Server/CMakeFiles/RemoteControlServer.dir/build.make Server/CMakeFiles/RemoteControlServer.dir/main.cpp.o
.PHONY : main.cpp.o

main.i: main.cpp.i
.PHONY : main.i

